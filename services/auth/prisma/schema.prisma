generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

enum UserRole {
  CUSTOMER
  ADMIN

  @@schema("auth")
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String                  @db.VarChar(80)
  email                  String                  @unique @db.VarChar(254)
  passwordHash           String
  role                   UserRole                @default(CUSTOMER)
  emailVerifiedAt        DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  emailVerificationCodes EmailVerificationCode[]

  @@schema("auth")
}

model EmailVerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime @db.Timestamptz(3)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@schema("auth")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("auth")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  exchange      String       @db.VarChar(100)
  routingKey    String       @db.VarChar(100)
  payload       Json
  correlationId String?      @db.VarChar(100)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?    @db.Timestamptz(3)

  @@index([status, createdAt])
  @@schema("auth")
}


