        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": false,
        "name": "service",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "gateway", "value": "gateway" },
          { "selected": false, "text": "auth", "value": "auth" },
          { "selected": false, "text": "catalog", "value": "catalog" },
          { "selected": false, "text": "booking", "value": "booking" },
          { "selected": false, "text": "orders", "value": "orders" },
          { "selected": false, "text": "notify", "value": "notify" }
        ],
        "query": "gateway,auth,catalog,booking,orders,notify",
        "queryValue": "",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "OrderFirst Fleet Overview",
