# ==============================================================================
# OrderFirst Monorepo Environment Configuration — PROD (Production Hardened)
# ==============================================================================
# Production-ready configuration. In production:
# - HTTPS is mandatory for FRONTEND_URL.
# - Default passwords and secrets MUST be replaced with cryptographically random strings:
#     openssl rand -hex 32
# - Only public ingress ports are published (Client & Gateway/Reverse Proxy).
#
# To use:
#   cp .env.prod.example .env.prod
# ==============================================================================

# 1. Global Runtime & Networking
NODE_ENV=production
LOG_LEVEL=info
FRONTEND_URL=https://orderfirst.yourdomain.com
TRUST_PROXY_HOPS=1

# 2. Security & Authentication Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET=generate-a-strong-random-secret-for-production-min-32-chars
JWT_EXPIRES_IN=86400
INTERNAL_SECRET=generate-a-strong-internal-secret-min-16-chars
RATE_LIMIT_ENABLED=true

# 3. Host Ingress Ports
CLIENT_PORT=80
GATEWAY_PORT=4000

# 4. Service Mesh Routing (Internal Container Hostnames)
AUTH_SERVICE_URL=http://auth:4001
CATALOG_SERVICE_URL=http://catalog:4002
BOOKING_SERVICE_URL=http://booking:4003
ORDERS_SERVICE_URL=http://orders:4004
NOTIFY_SERVICE_URL=http://notify:4005

# 5. PostgreSQL Database Configuration (Internal Only — No Host Port)
POSTGRES_DB=orderfirst_prod
POSTGRES_USER=postgres_prod_admin
POSTGRES_PASSWORD=replace-with-a-strong-postgres-master-password

# 6. Microservice Database Roles & Passwords
AUTH_DB_USER=auth_prod_user
AUTH_DB_PASSWORD=replace-with-a-strong-auth-db-password
CATALOG_DB_USER=catalog_prod_user
CATALOG_DB_PASSWORD=replace-with-a-strong-catalog-db-password
ORDERS_DB_USER=orders_prod_user
ORDERS_DB_PASSWORD=replace-with-a-strong-orders-db-password
BOOKING_DB_USER=booking_prod_user
BOOKING_DB_PASSWORD=replace-with-a-strong-booking-db-password

# 7. Database Connection URLs (Internal Postgres Container)
DATABASE_URL_AUTH=postgresql://auth_prod_user:replace-with-a-strong-auth-db-password@postgres:5432/orderfirst_prod?schema=auth
DATABASE_URL_CATALOG=postgresql://catalog_prod_user:replace-with-a-strong-catalog-db-password@postgres:5432/orderfirst_prod?schema=catalog
DATABASE_URL_BOOKING=postgresql://booking_prod_user:replace-with-a-strong-booking-db-password@postgres:5432/orderfirst_prod?schema=booking
DATABASE_URL_ORDERS=postgresql://orders_prod_user:replace-with-a-strong-orders-db-password@postgres:5432/orderfirst_prod?schema=orders

# 8. RabbitMQ Message Broker Configuration (Internal Only)
RABBITMQ_DEFAULT_USER=orderfirst_prod_rmq
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-rabbitmq-password
RABBITMQ_URL=amqp://orderfirst_prod_rmq:replace-with-a-strong-rabbitmq-password@rabbitmq:5672

# 9. Email & Notification Credentials (Production SMTP / SendGrid / SES)
EMAIL_USER=no-reply@yourdomain.com
EMAIL_APP_PASSWORD=production-smtp-app-password

# 10. Frontend Client Application (Production API Domain - default relative /api)
VITE_API_URL=/api

# 11. Monitoring & Observability (Prometheus, Loki, Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

