# ==============================================================================
# OrderFirst Monorepo Environment Configuration
# ==============================================================================
# This is the single source of truth for all environment variables used by:
# - All microservices (services/gateway, auth, catalog, booking, orders, notify)
# - The client single-page application (client/)
# - Infrastructure & Container orchestration (infra/ & deploy/compose/)
#
# To use:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Adjust values as needed for your local or production environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Runtime & Networking
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'test', or 'production'.
# In 'production', strict checks are enforced (HTTPS required, default secrets blocked).
NODE_ENV=development

# Application log level for Pino logger:
# 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent'
LOG_LEVEL=info

# Public origin of the frontend web application (no trailing slash).
# Used for CORS validation, cookie domain scoping, and email links.
# In production, this MUST use https://.
FRONTEND_URL=http://localhost:5173

# Number of upstream reverse-proxy hops (e.g. Nginx, Cloudflare, AWS ALB) to trust
# when extracting client IPs for rate-limiting and audit logging. Default: 0 (direct connection).
TRUST_PROXY_HOPS=0

# ------------------------------------------------------------------------------
# 2. Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Symmetric secret used to sign and verify user JSON Web Tokens (JWT).
# Must be at least 32 characters long. In production, use a cryptographically random string.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Access token time-to-live (TTL) in seconds.
# Range: 60 (1 minute) to 604800 (7 days). Default: 86400 (24 hours).
JWT_EXPIRES_IN=86400

# Shared secret key passed in the 'X-Internal-Secret' header for trusted
# inter-service communication within the private container network.
# Must be at least 16 characters long.
INTERNAL_SECRET=internal-secret-for-microservices-mesh-min-16-chars

# ------------------------------------------------------------------------------
# 3. Microservice Host Ports (Local Development & Port Mapping)
# ------------------------------------------------------------------------------
# API Gateway entry point (reverse proxy & aggregator)
GATEWAY_PORT=4000

# Authentication & User Management service
AUTH_PORT=4001

# Product Catalog & Menu Inventory service
CATALOG_PORT=4002

# Table Reservation & Booking service
BOOKING_PORT=4003

# Order Placement & Checkout State Machine service
ORDERS_PORT=4004

# Background Email & Push Notification daemon
NOTIFY_PORT=4005

# ------------------------------------------------------------------------------
# 4. Service Mesh Routing (Internal Inter-Service HTTP Endpoints)
# ------------------------------------------------------------------------------
# URLs used by the API Gateway to route external requests to downstream services,
# and by services (e.g., Orders -> Catalog) for direct internal RPC calls.
AUTH_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
BOOKING_SERVICE_URL=http://localhost:4003
ORDERS_SERVICE_URL=http://localhost:4004
NOTIFY_SERVICE_URL=http://localhost:4005

# ------------------------------------------------------------------------------
# 5. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Master database name
POSTGRES_DB=orderfirst

# Master administrative username
POSTGRES_USER=postgres

# Master administrative password
POSTGRES_PASSWORD=postgres_master_password

# Host port exposed for PostgreSQL container
# (Defaulted to 5433 to avoid colliding with any local PostgreSQL on 5432)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 6. PostgreSQL Microservice-Specific Roles (Least Privilege Isolation)
# ------------------------------------------------------------------------------
# Initialized automatically by infra/postgres/init/01-init.sh on first startup.
# Each service is granted access ONLY to its dedicated schema.
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password_123

CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_password_123

ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=orders_password_123

BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_password_123

# ------------------------------------------------------------------------------
# 7. Database Connection URLs (Prisma & Direct Database Access)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
# Used by services running on host machines (npm run dev) and Prisma CLI migrations.
DATABASE_URL_AUTH=postgresql://auth_user:auth_password_123@localhost:5433/orderfirst?schema=auth
DATABASE_URL_CATALOG=postgresql://catalog_user:catalog_password_123@localhost:5433/orderfirst?schema=catalog
DATABASE_URL_BOOKING=postgresql://booking_user:booking_password_123@localhost:5433/orderfirst?schema=booking
DATABASE_URL_ORDERS=postgresql://orders_user:orders_password_123@localhost:5433/orderfirst?schema=orders

# ------------------------------------------------------------------------------
# 8. RabbitMQ Message Broker Configuration
# ------------------------------------------------------------------------------
# Default administrative user & password for RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# AMQP connection URL used by event publishers (Auth, Orders) and consumers (Notify)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ------------------------------------------------------------------------------
# 9. Email & Notification Credentials (Nodemailer / Gmail SMTP)
# ------------------------------------------------------------------------------
# Gmail address or SMTP username used to dispatch verification OTPs and order receipts.
# Optional in local development; when omitted, notification services run in mock mode.
EMAIL_USER=admin@example.com

# Google App Password (16-character alphanumeric string generated in Google Account security).
EMAIL_APP_PASSWORD=gmail-app-password

# ------------------------------------------------------------------------------
# 10. Frontend Client Application (Vite / React)
# ------------------------------------------------------------------------------
# Base API URL consumed by the browser client, pointing to the API Gateway.
# Loaded by client/vite.config.ts via envDir: "../".
VITE_API_URL=http://localhost:4000/api
