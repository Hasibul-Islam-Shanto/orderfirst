# Environment Configuration Matrix for OrderFirst Microservices

# Shared Security & Configuration
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=86400
INTERNAL_SECRET=internal-secret-for-microservices-mesh-min-16-chars
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL Master & Dedicated Roles
POSTGRES_PASSWORD=postgres_master_password
DATABASE_URL_AUTH=postgresql://auth_user:auth_password_123@localhost:5432/orderfirst?schema=auth
DATABASE_URL_CATALOG=postgresql://catalog_user:catalog_password_123@localhost:5432/orderfirst?schema=catalog
DATABASE_URL_BOOKING=postgresql://booking_user:booking_password_123@localhost:5432/orderfirst?schema=booking
DATABASE_URL_ORDERS=postgresql://orders_user:orders_password_123@localhost:5432/orderfirst?schema=orders

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Service Ports & Mesh URLs
GATEWAY_PORT=4000
AUTH_PORT=4001
CATALOG_PORT=4002
BOOKING_PORT=4003
ORDERS_PORT=4004
NOTIFY_PORT=4005

AUTH_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
BOOKING_SERVICE_URL=http://localhost:4003
ORDERS_SERVICE_URL=http://localhost:4004
NOTIFY_SERVICE_URL=http://localhost:4005

# Email & Notifications (Optional in dev, required in production)
EMAIL_USER=admin@example.com
EMAIL_APP_PASSWORD=gmail-app-password

