# ==============================================================================
# OrderFirst Monorepo Environment Configuration — DEV (Dev / Staging VM)
# ==============================================================================
# Used for shared development or staging servers where all microservices run
# containerized inside the Docker network.
#
# To use:
#   cp .env.dev.example .env.dev
# ==============================================================================

# 1. Global Runtime & Networking
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost
TRUST_PROXY_HOPS=0

# 2. Security & Authentication Secrets
JWT_SECRET=dev-environment-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=86400
INTERNAL_SECRET=dev-internal-secret-min-16-chars
RATE_LIMIT_ENABLED=true

# 3. Host Port Mappings (Gateway, Client, and Management UI)
GATEWAY_PORT=4000
CLIENT_PORT=80
POSTGRES_PORT=5433

# 4. Service Mesh Routing (Internal Container Hostnames)
AUTH_SERVICE_URL=http://auth:4001
CATALOG_SERVICE_URL=http://catalog:4002
BOOKING_SERVICE_URL=http://booking:4003
ORDERS_SERVICE_URL=http://orders:4004
NOTIFY_SERVICE_URL=http://notify:4005

# 5. PostgreSQL Database Configuration
POSTGRES_DB=orderfirst_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_123

# 6. Microservice Database Roles & Passwords
AUTH_DB_USER=auth_dev_user
AUTH_DB_PASSWORD=auth_dev_password_123
CATALOG_DB_USER=catalog_dev_user
CATALOG_DB_PASSWORD=catalog_dev_password_123
ORDERS_DB_USER=orders_dev_user
ORDERS_DB_PASSWORD=orders_dev_password_123
BOOKING_DB_USER=booking_dev_user
BOOKING_DB_PASSWORD=booking_dev_password_123

# 7. Database Connection URLs (Internal Postgres Container)
DATABASE_URL_AUTH=postgresql://auth_dev_user:auth_dev_password_123@postgres:5432/orderfirst_dev?schema=auth
DATABASE_URL_CATALOG=postgresql://catalog_dev_user:catalog_dev_password_123@postgres:5432/orderfirst_dev?schema=catalog
DATABASE_URL_BOOKING=postgresql://booking_dev_user:booking_dev_password_123@postgres:5432/orderfirst_dev?schema=booking
DATABASE_URL_ORDERS=postgresql://orders_dev_user:orders_dev_password_123@postgres:5432/orderfirst_dev?schema=orders

# 8. RabbitMQ Message Broker Configuration
RABBITMQ_DEFAULT_USER=dev_guest
RABBITMQ_DEFAULT_PASS=dev_guest_pass
RABBITMQ_URL=amqp://dev_guest:dev_guest_pass@rabbitmq:5672

# 9. Email & Notification Credentials (Nodemailer / SMTP)
EMAIL_USER=dev-notifications@orderfirst.dev
EMAIL_APP_PASSWORD=dev-smtp-app-password

# 10. Frontend Client Application
VITE_API_URL=http://localhost:4000/api

